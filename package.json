{
  "name": "monkey-pet",
  "version": "0.6.0",
  "description": "桌面小猴宠物 (Electron) — 情绪/事件/吸附/防打扰/番茄钟/待办/剪贴板/系统监控/课程提醒/AI对话/名片识别/TTS/早报",
  "main": "main.js",
  "scripts": {
    "start": "node launcher.js",
    "dist": "electron-builder",
    "test": "node tools/test-anim.cjs && node tools/test-flight.cjs && node tools/test-bottle.cjs && node tools/test-wb.cjs && node tools/test-paper.cjs && node tools/test-daily.cjs",
    "lab": "electron tools/bottle-lab.js --states=drinking:0,sip:0.22,sip:0.46,sip-deep:0.9 --out=_shots/lab/bottle.png",
    "test:live": "node tools/test-wb-live.cjs",
    "test:bottle": "node tools/test-bottle.cjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.monkeypet.app",
    "productName": "小猴桌宠",
    "icon": "assets/icons/monkey.ico",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "bubble.html",
      "todo.html",
      "clip.html",
      "schedule.html",
      "settings.html",
      "chat.html",
      "card.html",
      "paper.html",
      "usage.html",
      "daily.js",
      "paper.js",
      "wb.js",
      "anim.js",
      "character.json",
      "launcher.js",
      "tools/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/monkey.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "pdfjs-dist": "^3.11.174"
  }
}

{
  "schema": 1,
  "id": "monkey-v1",
  "name": "小猴",
  "comment": "角色档案：换形象只改这个文件 + assets 里的图，anim.js 不含任何角色专属数值。所有比例量都以窗口为基准（dy 用高度、dx 用宽度），所以改窗口尺寸或换成别的动物都不用调代码。",

  "size": [192, 223],

  "frames": {
    "front": "d0",
    "side": "d2",
    "turnA": "d1",
    "emotions": {
      "angry": "e_angry",
      "cheer": "e_cheer",
      "love": "e_love",
      "sad": "e_sad",
      "shy": "e_shy",
      "sleepy": "e_sleepy",
      "surprised": "e_surprised",
      "thinking": "e_thinking",
      "wink": "e_wink"
    }
  },

  "anchors": {
    "foot": 0.995,
    "headCenter": [0.38, 0.28],
    "mouth": [0.555, 0.625],
    "comment": "foot = 脚底在窗口里的纵向位置，所有旋转/挤压都以它为支点；mouth 供叼烟、举瓶这类道具锚定"
  },

  "_eyesComment": "眩晕时盖在眼睛上的卡通眼。x/y 是眼球中心，w/h 是眼裂大小，全部按窗口比例。\n换形象必须重新量：先用 assets 里的正面帧找到虹膜（瞳孔）圆心，再取整个眼裂（白眼球+虹膜）的包围盒，\n稍微放大 3~5% 留边。量法见 tools/measure-eyes.py。\n如果新形象本来就有专用的眩晕脸，直接在 frames.emotions.dizzy 填帧名，这套几何就会自动停用。",
  "eyes": {
    "ink": "#2f2116",
    "points": [
      { "x": 0.47526, "y": 0.47657, "w": 0.14344, "h": 0.10621 },
      { "x": 0.66276, "y": 0.47657, "w": 0.14344, "h": 0.10621 }
    ]
  },

  "zones": [
    { "id": "head", "label": "头", "reaction": "headTap", "box": [0.24, 0.03, 0.80, 0.46] },
    { "id": "body", "label": "身子", "reaction": "bodyTap", "box": [0.14, 0.46, 0.94, 1.0] }
  ],

  "gait": {
    "speed": 0.62,
    "stride": 0.34,
    "bob": 0.024,
    "sway": 0.013,
    "leanDeg": 3.2,
    "rockDeg": 1.1,
    "squash": 0.06,
    "accel": 0.18,
    "comment": "speed=每秒走几个窗口宽；stride=一步覆盖几个窗口宽（决定步频，太快像抽筋，太慢像滑行）；bob/sway/rock 是每步的起伏、左右摆和身体摇摆，静态帧靠这三样才不滑行；accel=加减速占总行程的比例"
  },

  "schedule": {
    "gapMin": 7000,
    "gapMax": 18000,
    "cooldown": 40000,
    "comment": "gap=两个动作之间的静默间隔（这段时间只允许待机和转头，和 dsh-pet 的做法一致）；cooldown=同一个动作多久内不重复"
  },

